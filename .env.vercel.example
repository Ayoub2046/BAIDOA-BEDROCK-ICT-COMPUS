# Vercel Environment Variables Setup Guide
# =======================================================
# When deploying to Vercel, the local Backend/.env file is NOT uploaded (it is in .gitignore).
# You MUST add these environment variables in your Vercel Project Settings!
#
# HOW TO ADD IN VERCEL:
# 1. Go to https://vercel.com/dashboard
# 2. Select your project (BAIDOA-BEDROCK-ICT-COMPUS)
# 3. Go to: Settings -> Environment Variables
# 4. Add each Key/Value pair below for Production, Preview, and Development.
# 5. Save and trigger a REDEPLOY.
# =======================================================

# 1. Database URL (MUST use Port 6543 for Vercel serverless functions!)
# Do NOT use port 5432 on Vercel — port 5432 causes 30-47 second cold-start timeouts.
DATABASE_URL=postgresql://postgres.zsuevqquuhmitmizyblv:612554321.a%402026.A@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# 2. Supabase API Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://zsuevqquuhmitmizyblv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpzdWV2cXF1dWhtaXRtaXp5Ymx2Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NDM1MzQ5OSwiZXhwIjoyMDk5OTI5NDk5fQ.kMGic-lpxdnkQKo0JSjP_RSQo49thToFCUfcL_Jy-tc
SUPABASE_STORAGE_BUCKET=uploads

# 3. JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this

# 4. Enable serverless DB query logging / settings
NODE_ENV=production
