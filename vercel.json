{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/HTML/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/HTML/index.html"
    },
    {
      "source": "/favicon.ico",
      "destination": "/images/BEDRCOK LOGO.JPG"
    },
    {
      "source": "/goal",
      "destination": "/HTML/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
