{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/HTML/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/HTML/index.html"
    },
    {
      "source": "/:page.html",
      "destination": "/HTML/:page.html"
    }
  ]
}
